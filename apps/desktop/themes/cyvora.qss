/* Surface #000000. Accent #C084FC. Deep accent #A855F7. */

QWidget {
    background-color: #000000;
    color: #F4F1F8;
    font-family: "Segoe UI", "DejaVu Sans", sans-serif;
    font-size: 13px;
}

#Sidebar {
    background-color: #000000;
    border-right: 1px solid rgba(168, 85, 247, 0.28);
}

#Content {
    background-color: #000000;
}

#BrandMark {
    background: transparent;
}

#Slogan {
    color: #8E86A3;
    font-size: 11px;
    letter-spacing: 1.4px;
}

#ModeBadge {
    background-color: transparent;
    color: #E9D5FF;
    border: 1px solid rgba(192, 132, 252, 0.75);
    border-radius: 12px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 600;
}

#Headline {
    color: #E9D5FF;
    font-size: 16px;
    font-weight: 600;
    background: transparent;
}

#PageTitle {
    font-size: 28px;
    font-weight: 560;
    color: #F4F1F8;
    background: transparent;
}

#Notice, #EmptyState {
    color: #B7AEC4;
    font-size: 13px;
    background: transparent;
}

#LockNote {
    color: #B7AEC4;
    font-size: 13px;
    background: transparent;
}

#DetailToggle {
    background: transparent;
    color: #C084FC;
    border: none;
    padding: 2px 0;
    font-size: 12px;
}

#DetailToggle:hover {
    color: #E9D5FF;
}

#Hologram {
    background-color: #000000;
    border: none;
}

#StatusCard {
    background-color: #000000;
    border: 1px solid rgba(168, 85, 247, 0.38);
    border-radius: 16px;
}

#CardTitle {
    color: #B7AEC4;
    font-size: 11px;
    background: transparent;
}

#StateValue {
    color: #E9D5FF;
    font-size: 22px;
    font-weight: 600;
    background: transparent;
}

#CardDetail {
    color: #B7AEC4;
    font-size: 12px;
    background: transparent;
}

QTableWidget {
    background-color: #000000;
    alternate-background-color: #0A0A0C;
    color: #F4F1F8;
    gridline-color: #16141A;
    selection-background-color: #1A1024;
    selection-color: #E9D5FF;
    border: 1px solid rgba(168, 85, 247, 0.28);
    border-radius: 12px;
}

QHeaderView::section {
    background-color: #000000;
    color: #B7AEC4;
    border: none;
    border-bottom: 1px solid rgba(168, 85, 247, 0.35);
    padding: 10px 8px;
    font-size: 11px;
}

QLineEdit, QComboBox, QSpinBox {
    background-color: #000000;
    color: #F4F1F8;
    border: 1px solid rgba(168, 85, 247, 0.32);
    border-radius: 10px;
    padding: 8px 10px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #C084FC;
}

QPushButton#PrimaryButton, QPushButton#SecondaryButton {
    background-color: transparent;
    color: #E9D5FF;
    border: 1px solid rgba(192, 132, 252, 0.72);
    border-radius: 10px;
    padding: 8px 14px;
}

QPushButton#PrimaryButton:hover, QPushButton#SecondaryButton:hover {
    background-color: rgba(168, 85, 247, 0.16);
}

QPushButton#PrimaryButton:focus, QPushButton#SecondaryButton:focus {
    border: 1px solid #E9D5FF;
}

QPushButton#DangerButton {
    background-color: transparent;
    color: #F87171;
    border: 1px solid rgba(248, 113, 113, 0.7);
    border-radius: 10px;
    padding: 8px 14px;
}

QCheckBox {
    color: #B7AEC4;
    background: transparent;
    spacing: 8px;
}

QTextEdit, QPlainTextEdit, QScrollArea {
    background-color: #000000;
    color: #F4F1F8;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 0;
}

QScrollBar::handle:vertical {
    background: rgba(168, 85, 247, 0.45);
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: rgba(168, 85, 247, 0.45);
    border-radius: 4px;
}

QToolTip {
    background-color: #0A0A0C;
    color: #F4F1F8;
    border: 1px solid rgba(192, 132, 252, 0.65);
    padding: 6px 8px;
}
