# Copy this file to .env for local development. Never commit .env.
# Placeholders below are not real credentials.

# READ_ONLY or PAPER. Live modes are rejected.
# PAPER can store an explicit simulated order. It does not sign or submit one.
CYVORA_EXECUTION_MODE=READ_ONLY

# The API refuses any host other than loopback.
CYVORA_API_HOST=127.0.0.1
CYVORA_API_PORT=8787

# Leave unset until a local PostgreSQL database exists.
# Example shape only; replace CHANGE_ME locally and do not paste it into chat:
# CYVORA_DATABASE_URL=postgresql+psycopg://cyvora:CHANGE_ME@127.0.0.1:5432/cyvora

CYVORA_LOG_LEVEL=INFO
CYVORA_ENVIRONMENT=local

# GMGN Agent API key from https://gmgn.ai/ai. Read-only market and token calls only.
# CYVORA_GMGN_API_KEY is accepted as an alias. Do not add GMGN_PRIVATE_KEY.
# CYVORA will not load a private key and will not call a trade route.
GMGN_API_KEY=CHANGE_ME

# Optional leaky-bucket plan used to pace requests: free, plus, or pro.
# The default is free (5/5). CYVORA does not buy a plan.
# CYVORA_GMGN_PLAN=free
# CYVORA_GMGN_TIMEOUT_SECONDS=10

# Required before /radar routes accept a request. /health stays open.
# The desktop reads PostgreSQL directly and does not send this token.
# CYVORA_API_TOKEN=CHANGE_ME

# Radar stays on Solana. Defaults: analyse 2 tokens, weight budget 30, interval 120s.
# Discovery is weight 5. Each token's info, security, pool, and kline reads are weight 5.
# Holder and trader reads are weight 5 each and run only when budget remains.
# The free plan bucket is still 5/5. CYVORA does not buy a plan.
# CYVORA_RADAR_ANALYSE_LIMIT=2
# CYVORA_RADAR_BUDGET_WEIGHT=30
# CYVORA_RADAR_SCAN_INTERVAL_SECONDS=120

# Local supervisor, backup, and diagnostics. Paths stay inside the workspace.
# A scheduled task is not registered by these defaults.
# CYVORA_WORKER_STALE_AFTER_SECONDS=900
# CYVORA_WORKER_RESTART_LIMIT=2
# CYVORA_BACKUP_DIR=backups
# CYVORA_DIAGNOSTICS_DIR=diagnostics
# CYVORA_LOG_RETENTION_DAYS=14
# CYVORA_AUTH_FAILURE_LIMIT=8

# Telegram delivery stays off unless CYVORA_TELEGRAM_ENABLED is true.
# The token is read from this file and is not logged. Do not commit .env.
# CYVORA_TELEGRAM_ENABLED=false
# CYVORA_TELEGRAM_BOT_TOKEN=CHANGE_ME
# CYVORA_TELEGRAM_CHAT_ID=0
# CYVORA_TELEGRAM_MIN_INTERVAL_SECONDS=2
# CYVORA_TELEGRAM_BURST=5

# The kill switch is a database row, not an environment flag.
# There is no setting that enables live trading.
# Do not add GMGN_PRIVATE_KEY. CYVORA will not load it.

# Autonomous paper trader. These do nothing until the supervisor is started
# with --paper-trader. The bankroll is virtual. It is not a wallet balance.
# CYVORA_PAPER_BANKROLL_SOL=10
# CYVORA_PAPER_PER_TRADE_FRACTION=0.10
# CYVORA_PAPER_MAX_EXPOSURE_FRACTION=0.40
# CYVORA_PAPER_MIN_SCORE=65
# CYVORA_PAPER_MAX_ENTRIES_PER_CYCLE=1
# CYVORA_PAPER_STOP_FRACTION=0.10
# CYVORA_PAPER_QUOTE_LIMIT=3
# CYVORA_PAPER_QUOTE_MAX_AGE_SECONDS=120
# CYVORA_PAPER_ALLOW_RISKY_SECURITY=false

# Desktop motion. false stops the dashboard hologram, page fades, and hover glow.
# Colors and layout stay the same. Restart the desktop after changing it.
# CYVORA_UI_ANIMATIONS=true
