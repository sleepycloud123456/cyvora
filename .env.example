# Copy this file to .env for local development. Never commit .env.
# Placeholders below are not real credentials.

# READ_ONLY or PAPER. Live modes are rejected.
CYVORA_EXECUTION_MODE=READ_ONLY

# The API refuses any host other than loopback.
CYVORA_API_HOST=127.0.0.1
CYVORA_API_PORT=8787

# Leave unset until a local PostgreSQL database exists.
# Example shape only; replace CHANGE_ME locally and do not paste it into chat:
# CYVORA_DATABASE_URL=postgresql+psycopg://cyvora:CHANGE_ME@127.0.0.1:5432/cyvora

CYVORA_LOG_LEVEL=INFO
CYVORA_ENVIRONMENT=local
